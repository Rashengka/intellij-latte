{*
	A declared array and two typed {var}s - one of them a long array literal - a
	condition on the array, and a list item carrying n:foreach, n:ifset and n:if at
	once, with a computed value inside a style attribute and an {if}/{else} holding
	a loop with a separator. Nothing in this file may be underlined.
*}
{varType array $data}
{var int $gap = 8}
{var array $order = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]}
{if $data}
<ul class="bars">
	<li n:foreach="$order as $pos => $n" n:ifset="$data[$n]" n:if="$pos % 2 === 0" style="margin-left: {$gap * $pos}px">
		{if count($data[$n]) > 3}
			{foreach $data[$n] as $bit}<b>{$bit}</b>{sep} &middot; {/sep}{/foreach}
		{else}
			<i>{$data[$n]}</i>
		{/if}
	</li>
</ul>
{/if}
